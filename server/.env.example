# ===== Rap Zone server configuration =====
PORT=4000

# Public base URL the app/admin use to reach this API (no trailing slash).
# For the Android app to reach a LAN server, use your PC's LAN IP, e.g. http://192.168.1.10:4000
PUBLIC_BASE_URL=http://localhost:4000

# PostgreSQL (used when USE_EMBEDDED_DB=false)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=rapzone

# Set true to run a local embedded PostgreSQL (auto-downloads once, data in server/.pgdata)
USE_EMBEDDED_DB=false

# Change this in production! (used to sign JWTs)
JWT_SECRET=rapzone-change-this-secret
JWT_EXPIRES_IN=7d

# Admin bootstrap (created on first boot if no admin exists)
ADMIN_EMAIL=admin@rapzone.app
ADMIN_PASSWORD=Admin@123

# CORS: comma separated list of allowed origins (the admin panel origin)
CORS_ORIGINS=http://localhost:8080

# ===== Media storage =====
# local (default, files in server/media) | s3 (AWS or any S3-compatible bucket)
STORAGE_DRIVER=local
# Max upload size in bytes (60 MB default)
MAX_UPLOAD_SIZE=62914560
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE=

# ===== Content policy (requirement: rights & licensing) =====
# Require license declaration when publishing artists/songs
REQUIRE_LICENSE=false
